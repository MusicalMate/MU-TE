<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mute.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_myListDetailFragment"
            app:destination="@id/myListDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_actorDetailFragment"
            app:destination="@id/actorDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_musicalDetailFragment"
            app:destination="@id/musicalDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_homeAllFragment"
            app:destination="@id/homeAllFragment" />
    </fragment>

    <fragment
        android:id="@+id/addFileFragment"
        android:name="com.example.mute.ui.add.AddFileFragment"
        android:label="fragment_add_file"
        tools:layout="@layout/fragment_add_file">
        <action
            android:id="@+id/action_addFileFragment_to_addImageFragment"
            app:destination="@id/addImageFragment" />
        <action
            android:id="@+id/action_addFileFragment_to_addVideoFragment"
            app:destination="@id/addVideoFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.mute.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.example.mute.ui.mypage.MyPageFragment"
        android:label="fragment_my_page"
        tools:layout="@layout/fragment_my_page" />
    <fragment
        android:id="@+id/actorDetailFragment"
        android:name="com.example.mute.ui.detail.ActorDetailFragment"
        android:label="ActorDetailFragment">
        <action
            android:id="@+id/action_actorDetailFragment_to_allVideoFragment"
            app:destination="@id/allVideoFragment" />
        <action
            android:id="@+id/action_actorDetailFragment_to_allPhotoFragment"
            app:destination="@id/allPhotoFragment" />
        <action
            android:id="@+id/action_actorDetailFragment_to_allLinkFragment"
            app:destination="@id/allLinkFragment" />
        <argument
            android:name="actor_id"
            app:argType="string" />
        <action
            android:id="@+id/action_actorDetailFragment_to_videoPlayFragment"
            app:destination="@id/videoPlayFragment" />
    </fragment>
    <fragment
        android:id="@+id/musicalDetailFragment"
        android:name="com.example.mute.ui.detail.MusicalDetailFragment"
        android:label="MusicalDetailFragment">
        <action
            android:id="@+id/action_musicalDetailFragment_to_allVideoFragment"
            app:destination="@id/allVideoFragment" />
        <action
            android:id="@+id/action_musicalDetailFragment_to_allPhotoFragment"
            app:destination="@id/allPhotoFragment" />
        <action
            android:id="@+id/action_musicalDetailFragment_to_allLinkFragment"
            app:destination="@id/allLinkFragment" />
        <argument
            android:name="musical_id"
            app:argType="string" />
        <action
            android:id="@+id/action_musicalDetailFragment_to_videoPlayFragment"
            app:destination="@id/videoPlayFragment" />
    </fragment>
    <fragment
        android:id="@+id/myListDetailFragment"
        android:name="com.example.mute.ui.detail.MyListDetailFragment"
        android:label="MyListDetailFragment">
        <action
            android:id="@+id/action_myListDetailFragment_to_allVideoFragment"
            app:destination="@id/allVideoFragment" />
        <action
            android:id="@+id/action_myListDetailFragment_to_allPhotoFragment"
            app:destination="@id/allPhotoFragment" />
        <action
            android:id="@+id/action_myListDetailFragment_to_allLinkFragment"
            app:destination="@id/allLinkFragment" />
        <argument
            android:name="my_list_name"
            app:argType="string" />
        <action
            android:id="@+id/action_myListDetailFragment_to_videoPlayFragment"
            app:destination="@id/videoPlayFragment" />
    </fragment>
    <fragment
        android:id="@+id/allVideoFragment"
        android:name="com.example.mute.ui.all.AllVideoFragment"
        android:label="AllVideoFragment" >
        <argument
            android:name="video_items"
            app:argType="com.example.mute.model.ContentInfo[]" />
        <action
            android:id="@+id/action_allVideoFragment_to_videoPlayFragment"
            app:destination="@id/videoPlayFragment" />
    </fragment>
    <fragment
        android:id="@+id/allLinkFragment"
        android:name="com.example.mute.ui.all.AllLinkFragment"
        android:label="AllLinkFragment" />
    <fragment
        android:id="@+id/allPhotoFragment"
        android:name="com.example.mute.ui.all.AllPhotoFragment"
        android:label="AllPhotoFragment" >
        <argument
            android:name="photo_items"
            app:argType="com.example.mute.model.ContentInfo[]" />
    </fragment>
    <fragment
        android:id="@+id/addImageFragment"
        android:name="com.example.mute.ui.add.AddImageFragment"
        android:label="AddImageFragment">
        <argument
            android:name="absolute_path"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/homeAllFragment"
        android:name="com.example.mute.ui.home.HomeAllFragment"
        android:label="HomeAllFragment">
        <action
            android:id="@+id/action_homeAllFragment_to_myListDetailFragment"
            app:destination="@id/myListDetailFragment" />
        <action
            android:id="@+id/action_homeAllFragment_to_actorDetailFragment"
            app:destination="@id/actorDetailFragment" />
        <action
            android:id="@+id/action_homeAllFragment_to_musicalDetailFragment"
            app:destination="@id/musicalDetailFragment" />
        <argument
            android:name="item_type"
            app:argType="string" />
        <argument
            android:name="Home_Items"
            app:argType="com.example.mute.ui.home.HomeItem[]" />
    </fragment>
    <fragment
        android:id="@+id/videoPlayFragment"
        android:name="com.example.mute.ui.filePlay.VideoPlayFragment"
        android:label="VideoPlayFragment" />
    <fragment
        android:id="@+id/addVideoFragment"
        android:name="com.example.mute.ui.add.AddVideoFragment"
        android:label="fragment_add_video"
        tools:layout="@layout/fragment_add_video" >
        <argument
            android:name="absolute_path"
            app:argType="string" />
    </fragment>
</navigation>