<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.example.mute.ui.add.AddActorViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.add.AddActorDialog">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/layout_add_actor_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@{viewModel.musicalTitle}"
                app:titleCentered="true" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_add_actor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_add_actor_top"
            app:spanCount="3" />

        <TextView
            android:id="@+id/tv_add_actor_cancel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/add_cancel"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/layout_add_actor_top"
            app:layout_constraintStart_toStartOf="@id/layout_add_actor_top"
            app:layout_constraintTop_toTopOf="@id/layout_add_actor_top" />

        <TextView
            android:id="@+id/tv_add_actor_select"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/select"
            android:textColor="@color/primary2"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/layout_add_actor_top"
            app:layout_constraintEnd_toEndOf="@id/layout_add_actor_top"
            app:layout_constraintTop_toTopOf="@id/layout_add_actor_top" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>